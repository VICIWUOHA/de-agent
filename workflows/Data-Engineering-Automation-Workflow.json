    {
      "parameters": {
        "jsCode": "const chResponse = $input.first().json;\nconst plan = $('Parse Ad-hoc Plan JSON').first().json;\nconst format = plan.output_format || 'table';\nlet formatted = '';\n\ntry {\n  if (chResponse.data && chResponse.meta) {\n    const cols = chResponse.meta.map(m => m.name);\n    const rows = chResponse.data;\n\n    if (format === 'csv') {\n      formatted = [cols.join(','), ...rows.map(r => r.join(','))].join('\\n');\n    } else {\n      const widths = cols.map((col, i) =>\n        Math.max(col.length, ...rows.map(r => String(r[i] ?? '').length))\n      );\n      const pad = (val, w) => String(val ?? '').padEnd(w);\n      const header = cols.map((c, i) => pad(c, widths[i])).join('  ');\n      const sep   = widths.map(w => '-'.repeat(w)).join('  ');\n      const body  = rows.map(r => r.map((v, i) => pad(v, widths[i])).join('  ')).join('\\n');\n      formatted = `${header}\\n${sep}\\n${body}`;\n    }\n  } else {\n    formatted = JSON.stringify(chResponse, null, 2);\n  }\n} catch(e) {\n  formatted = JSON.stringify(chResponse, null, 2);\n}\n\nconst rowCount = chResponse.rows || chResponse.data?.length || 0;\nreturn [{ json: {\n  formatted, rowCount, format, plan,\n  rawData: chResponse.data || [],\n  rawMeta: chResponse.meta || []\n} }];"
      },
