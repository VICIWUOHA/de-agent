    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet text = '', user = '', ts = '', channel = '';\n\nif (input.type === 'reaction_added') {\n  text = `[Reaction] :${input.reaction}: on message in ${input.item?.channel}`;\n  user = input.user || '';\n  ts = input.item?.ts || '';\n  channel = input.item?.channel || '';\n} else {\n  text = (input.text || '').replace(/^<@[A-Z0-9]+>\\s*/i, '').trim();\n  user = input.user || '';\n  ts = input.ts || '';\n  channel = input.channel || '';\n}\n\nreturn [{ json: { text, user, ts, channel } }];"
      },
