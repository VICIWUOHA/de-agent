# DE Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -- ngrok -------------------------------------------------------------------
# Get your auth token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-auth-token

# Your static domain from: https://dashboard.ngrok.com/cloud-edge/domains
NGROK_STATIC_DOMAIN=your-name-abc123.ngrok-free.app

# -- Cloudflare Tunnel (disabled) --------------------------------------------
# Get your token from: https://dash.cloudflare.com/one/ → Networks → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=

# -- n8n ---------------------------------------------------------------------
# Public URL n8n uses to register webhooks — must match your ngrok static domain
WEBHOOK_URL=https://your-name-abc123.ngrok-free.app

# n8n login credentials
N8N_USER=you@example.com
N8N_PASSWORD=change-me

# Random secret used to encrypt n8n credentials at rest
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

N8N_DIAGNOSTICS_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Timezone — full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=UTC

# -- ClickHouse --------------------------------------------------------------
# Docker Compose: use the clickhouse service name on the de-agent network
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DB=default
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=false

# For ClickHouse Cloud:
# CLICKHOUSE_HOST=your-instance.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-clickhouse-password
# CLICKHOUSE_DB=default
# CLICKHOUSE_SECURE=true
# CLICKHOUSE_VERIFY=true

# -- ClickHouse MCP ----------------------------------------------------------
# URL n8n uses to reach the MCP server (HTTP Streamable transport — /mcp).
# SSE (/sse) was deprecated in the MCP spec in 2025; use /mcp for new setups.
CLICKHOUSE_MCP_URL=http://mcp:8000/mcp

# -- Slack -------------------------------------------------------------------
# Bot token from: https://api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
